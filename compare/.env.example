# ─────────────────────────────────────────────────────────────────────────────
# BandingHidup — Environment Variables Template
# Copy this file to apps/web/.env.local and fill in your actual values.
# NEVER commit real secret keys to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase Configuration ───────────────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ── Application Metadata ─────────────────────────────────────────────────────
# Local dev keeps NEXT_PUBLIC_APP_DOMAIN=localhost:3000; production is set in the Netlify dashboard to https://compare.t-agung.id
NEXT_PUBLIC_APP_DOMAIN=https://compare.t-agung.id
NEXT_PUBLIC_BLOG_URL=https://t-agung.id
NEXT_PUBLIC_DEFAULT_LOCALE=id

# ── Crowdsourcing & Governance Configuration ────────────────────────────────
NEXT_PUBLIC_ALLOW_DIRECT_BENCHMARK_UPDATES=true

# ── Germany: Statistisches Bundesamt (Destatis GENESIS-Online) ───────────────
DESTATIS_USERNAME=your_destatis_username_or_email
DESTATIS_PASSWORD=your_destatis_password
DESTATIS_API_BASE_URL=https://www-genesis.destatis.de/genesisWS/rest/2020

# ── Japan: Statistics Bureau (e-Stat API) ────────────────────────────────────
ESTAT_APP_ID=your_estat_app_id_here
ESTAT_API_BASE_URL=https://api.e-stat.go.jp/rest/3.0/app/json

# ── Indonesia: Badan Pusat Statistik (BPS Web API) ───────────────────────────
BPS_API_KEY=your_bps_api_key_here
BPS_API_BASE_URL=https://webapi.bps.go.id/v1/api

# ── United States: Economic & Labor Statistics APIs ──────────────────────────
FRED_API_KEY=your_fred_api_key_here
FRED_API_BASE_URL=https://api.stlouisfed.org/fred
BLS_API_KEY=your_bls_api_key_here
BLS_API_BASE_URL=https://api.bls.gov/publicAPI/v2
CENSUS_API_KEY=your_census_api_key_here
DATA_GOV_API_KEY=your_data_gov_api_key_here
