{
  "name": "@bandinghidup/core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript domain models, monetary math, i18n, and Supabase types for BandingHidup",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./money": {
      "import": "./dist/money/currency.js",
      "types": "./dist/money/currency.d.ts"
    },
    "./types": {
      "import": "./dist/types/supabase.js",
      "types": "./dist/types/supabase.d.ts"
    },
    "./i18n/*": {
      "import": "./src/i18n/*.json",
      "default": "./src/i18n/*.json"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "decimal.js": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
